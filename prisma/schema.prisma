generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

//
// Common
//
enum Locale {
  EN
  RU
}

//
// Profile
//
model Profile {
  id          String        @id @default(uuid())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  locale      Locale
  location    String
  email       String
  name        String
  slug        String        @unique
  headline    String
  summary     String
  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
}

model ProfileLink {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  profileId   String
  label       String
  url         String
  position    Int
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects    Project[]
  experiences Experience[]

  @@index([profileId, position])
}

// 
// Skills
//
enum SkillCategory {
  LANGUAGE
  BACKEND
  FRONTEND
  MOBILE
  DATABASE
  CLOUD
  AI
  INTEGRATION
}

model Skill {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profileId String
  name      String
  category  SkillCategory
  position  Int
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId, position])
}

//
// Expirience
//
model Experience {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  profileId     String
  company       String
  title      String
  location      String?
  startDate     DateTime     @db.Date
  endDate       DateTime?    @db.Date
  bulletpoints  String[]
  stack         String[]
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileLink   ProfileLink? @relation(fields: [profileLinkId], references: [id])
  profileLinkId String?

  @@index([profileId, startDate])
}

//
// Projects
//
model Project {
  id            String       @id @default(uuid())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  profileId     String
  name          String
  description   String
  url           String?
  repositoryUrl String?
  stack         String[]
  position      Int
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileLink   ProfileLink? @relation(fields: [profileLinkId], references: [id])
  profileLinkId String?

  @@index([profileId, position])
}
